```cshtml
@{
    ViewData["Title"] = "Contact";
}

<section class="contact-page">
    <div class="container-xl">
        <div class="contact-intro text-center" data-aos="fade-up">
            <h1>Get in Touch</h1>
            <p>
                Interested in getting a tattoo?
                For bookings and inquiries, feel free to get in touch.
            </p>
        </div>

        <div class="contact-methods"
             data-aos="fade-up"
             data-aos-delay="100">

            <a href="https://www.instagram.com/xema.tattoos/"
               target="_blank"
               rel="noopener noreferrer"
               class="contact-method">
                <span class="contact-method-label">Instagram</span>
                <span class="contact-method-value">@@xema.tattoos</span>
            </a>

            <a href="mailto:YOUR_EMAIL@example.com"
               class="contact-method">
                <span class="contact-method-label">Email</span>
                <span class="contact-method-value">YOUR_EMAIL@example.com</span>
            </a>

        </div>

        <div class="contact-booking"
             data-aos="fade-up"
             data-aos-delay="200">
            <h2>Booking Inquiries</h2>
            <p>
                When getting in touch, please include a brief description
                of your tattoo idea, the desired placement and approximate
                size, as well as any reference images you may have.
            </p>
            <p>
                If you already have a preferred timeframe, feel free to
                include that as well.
            </p>
        </div>
    </div>
</section>
```