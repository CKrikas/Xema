@{
    ViewData["Title"] = "About";
}

<!-- Introduction -->

<section class="about-intro">

    <div class="container-xl">

        <div class="row align-items-center g-5">

            <div class="col-lg-6"
                 data-aos="fade-right">

                <img src="~/images/about/artist.jpg"
                     class="about-image"
                     alt="XEMA Tattoo Artist" />

            </div>

            <div class="col-lg-6"
                 data-aos="fade-left">

                <div class="about-text">

                    <p class="about-eyebrow">
                        XEMA TATTOO
                    </p>

                    <h1>Art, translated onto the skin.</h1>

                    <p>
                        I'm Evi, a tattoo artist based in Athens.
                        I've been working professionally since September
                        2023, but art has been part of my life for as long
                        as I can remember.
                    </p>

                    <p>
                        I grew up painting and drawing, and eventually
                        became interested in what would happen when my
                        artistic style moved from paper onto the body.
                        Tattooing became a way to explore that idea while
                        creating something personal together with each
                        client.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Process -->

<section class="about-process">

    <div class="container-xl">

        <div class="about-section-heading text-center"
             data-aos="fade-up">

            <h2>A Personal Process</h2>

            <p>
                Every tattoo starts with a conversation.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4"
                 data-aos="fade-up">

                <div class="about-card">

                    <span class="about-card-number">01</span>

                    <h3>Talk</h3>

                    <p>
                        Before anything is tattooed, we talk about your
                        idea, what you want to create and what matters
                        to you.
                    </p>

                </div>

            </div>

            <div class="col-md-4"
                 data-aos="fade-up"
                 data-aos-delay="100">

                <div class="about-card">

                    <span class="about-card-number">02</span>

                    <h3>Explore</h3>

                    <p>
                        Ideas are exchanged and developed together,
                        allowing the design to take shape naturally.
                    </p>

                </div>

            </div>

            <div class="col-md-4"
                 data-aos="fade-up"
                 data-aos-delay="200">

                <div class="about-card">

                    <span class="about-card-number">03</span>

                    <h3>Create</h3>

                    <p>
                        The final tattoo is created with attention to
                        both the design and the person wearing it.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Artistic Background -->

<section class="about-art">

    <div class="container-xl">

        <div class="row align-items-center g-5">

            <div class="col-lg-6 order-lg-2"
                 data-aos="fade-left">

                <img src="~/images/about/art.jpg"
                     class="about-image"
                     alt="Artwork by XEMA" />

            </div>

            <div class="col-lg-6 order-lg-1"
                 data-aos="fade-right">

                <div class="about-text">

                    <p class="about-eyebrow">
                        ART &amp; INSPIRATION
                    </p>

                    <h2>From painting to tattooing.</h2>

                    <p>
                        Painting has been part of my life since childhood.
                        I have always been drawn to creating things and
                        exploring different ways of expressing an idea.
                    </p>

                    <p>
                        Tattooing gave me a different way to approach that
                        process. Instead of creating only on paper, I could
                        see how an image changes when it becomes part of
                        someone's body.
                    </p>

                    <p>
                        My style continues to evolve with time, experience
                        and the people I work with.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Personal -->

<section class="about-personal">

    <div class="container-xl">

        <div class="about-personal-content"
             data-aos="fade-up">

            <p class="about-eyebrow">
                BEYOND THE STUDIO
            </p>

            <h2>When I'm not tattooing</h2>

            <p>
                Outside of tattooing, I'm still surrounded by art.
                Painting and sketching remain important parts of my life,
                and music is a big part of my creative process.
            </p>

            <p>
                I spend my time listening to music, drawing, enjoying
                coffee, spending time with friends and appreciating
                the small things that make everyday life interesting.
            </p>

        </div>

    </div>

</section>


<!-- Final CTA -->

<section class="cta-section text-center"
         data-aos="fade-up">

    <div class="container-xl">

        <h2>Have an idea in mind?</h2>

        <p class="text-muted mb-4">
            Let's talk about it.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="btn btn-dark px-4">

            Get in Touch

        </a>

    </div>

</section>