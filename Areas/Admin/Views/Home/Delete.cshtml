@model xema.Models.HeroBanner

@{
    ViewData["Title"] = "Delete Hero Banner";
}

<h1>Delete Hero Banner</h1>

<h3>Are you sure you want to delete this hero banner?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Heading
    </dt>

    <dd class="col-sm-9">
        @Model.Heading
    </dd>

    <dt class="col-sm-3">
        Subheading
    </dt>

    <dd class="col-sm-9">
        @Model.Subheading
    </dd>

    <dt class="col-sm-3">
        Button Text
    </dt>

    <dd class="col-sm-9">
        @Model.ButtonText
    </dd>

    <dt class="col-sm-3">
        Button Link
    </dt>

    <dd class="col-sm-9">
        @Model.ButtonLink
    </dd>

    <dt class="col-sm-3">
        Image URL
    </dt>

    <dd class="col-sm-9">
        @Model.Media.Url
    </dd>

</dl>

<form asp-action="Delete">

    <input type="hidden" asp-for="Id" />

    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-secondary">
        Cancel
    </a>

</form>