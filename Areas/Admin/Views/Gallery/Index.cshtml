@model IEnumerable<xema.Models.TattooImage>

@{
    ViewData["Title"] = "Index";
}

<h1>Gallery</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

@if (TempData["WarningMessage"] is string warning)
{
    <div class="alert alert-warning" role="alert">
        @warning
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Media.Url)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UploadedAt)
            </th>
            <th>
                Category
            </th>
            <th>
                Featured
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Title)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Description)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Media.Url)
                </td>

                <td>
                    @Html.DisplayFor(model => item.UploadedAt)
                </td>

                <td>
                    @item.Category?.Name
                </td>

                <td class="text-center">
                    @(item.IsFeatured ? "✔️" : "❌")
                </td>

                <td>
                    <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-area="Admin" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-area="Admin" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>